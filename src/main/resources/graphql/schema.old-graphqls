"""
GraphQL schema generated from TransitClock OpenAPI spec (docs.yaml)
Source: components.schemas of the TheTransitClock API definition

Naming: the OpenAPI "Api" prefix (ApiVehicle, ApiRoute, ApiBlock, ...) has
been stripped from every type, since it added no information in a schema
that is already scoped to this API. ApiLocation was additionally merged
into the pre-existing Location type ({ lat, lon }) — the two were
structurally identical.

Envelopes: 21 types that only existed to wrap a single list field (e.g.
the old "VehiclesResponse { data: [Vehicle] }") have been removed. Fields
and arguments that used to return those wrapper types now return the list
directly (e.g. Query.getVehicles: [Vehicle]) — REST needs one JSON root
object per response, GraphQL doesn't. "Response" types that carry extra
fields alongside their array (RoutesResponse, PredictionsResponse,
SchedulesVertStopsResponse, ...) were left as-is since they aren't pure
wrappers.

Other patterns worth knowing about:
- CacheKey family (HistoricalAverageCacheKey, KalmanErrorCacheKey,
HoldingTimeCacheKey) all fed a now-removed "*CacheKeysResponse"
envelope; HistoricalAverageCacheKey and KalmanErrorCacheKey are
field-for-field identical and are good candidates to unify.
- "Terse" variants (BlockTerse, TripTerse) are lean projections of
Block/Trip - a shared interface could express the common subset.
- ScheduleVertStops / ScheduleHorizStops mirror each other (routes
viewed by stop-then-time vs trip-then-time).
- Extent (bounding box) and GpsLocation both build on the same
lat/lon pair used by the shared Location type.

--- https://graphql.org/
"""

#"""
#Use an asynchronous data fetcher on a separate thread for this field.
#
#This is useful when adding several queries in the same HTTP request, for example by using a batch: Those
#fields annotated with this directive run in parallel.
#
#This is only worth it when the execution is long running, i.e. more than ~50 milliseconds, so this doesn't happen by default.
#"""
#directive @async on FIELD_DEFINITION
#
#"This directive allows results to be deferred during execution"
#directive @defer(
#    "Deferred behaviour is controlled by this argument"
#    if: Boolean! = true,
#    "A unique label that represents the fragment being deferred"
#    label: String
#) on FRAGMENT_SPREAD | INLINE_FRAGMENT
#
#"Marks the field, argument, input field or enum value as deprecated"
#directive @deprecated(
#    "The reason for the deprecation"
#    reason: String! = "No longer supported"
#) on FIELD_DEFINITION | ARGUMENT_DEFINITION | ENUM_VALUE | INPUT_FIELD_DEFINITION
#
#
#"Directs the executor to include this field or fragment only when the `if` argument is true"
#directive @include(
#    "Included when true."
#    if: Boolean!
#) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
#
#"Exactly one of the fields on an input object must be set and non-null while all others are omitted."
#directive @oneOf on INPUT_OBJECT
#
#"Directs the executor to skip this field or fragment when the `if` argument is true."
#directive @skip(
#    "Skipped when true."
#    if: Boolean!
#) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
#
#"Exposes a URL that specifies the behaviour of this scalar."
#directive @specifiedBy(
#    "The URL that specifies the behaviour of this scalar."
#    url: String!
#) on SCALAR
#
#"Add timing data to prometheus, if Actuator API is enabled"
#directive @timingData on FIELD_DEFINITION


type CommandAck {
    success: Boolean
    message: String
}

type Prediction {
    time: Float
    sec: Int
    min: Int
    scheduleBased: Boolean
    departure: Boolean
    trip: String
    blockId: String
    tripPattern: String
    vehicle: String
    atEndOfTrip: Boolean
    delayed: Boolean
    lateAndSubsequentTripSoMarkAsUncertain: Boolean
    notYetDeparted: Boolean
    passengerCount: String
    isDeparture: String
    affectedByLayover: String
}

type PredictionDestination {
    directionId: String
    headsign: String
    predictions: [Prediction]
}

type PredictionRouteStop {
    routeShortName: String
    routeName: String
    routeId: String
    stopId: String
    stopName: String
    stopCode: Int
    distanceToStop: Float
    destinations: [PredictionDestination]
}

type PredictionsResponse {
    agencyId: String
    agencyName: String
    data: [PredictionRouteStop]
}

type Agency {
    agencyId: String
    id: String
    name: String
    url: String
    timezone: String
    timezoneOffsetMinutes: Int
    lang: String
    speedUnit: String
    phone: String
    fareUrl: String
    extent: Extent
    configRev: Int
}

type Extent {
    minLat: Float
    minLon: Float
    maxLat: Float
    maxLon: Float
}

type GpsLocation {
    lat: Float
    lon: Float
    time: Float
    speed: Float
    heading: Float
}

type Vehicle {
    id: String
    loc: GpsLocation
    routeId: String
    routeShortName: String
    headsign: String
    vehicleType: String
    direction: String
    scheduleBased: Boolean
}

type VehicleToBlockConfig {
    id: Float
    vehicleId: String
    validFrom: Float
    validTo: Float
    assignmentDate: Float
    tripId: String
    blockId: String
}

type HoldingTime {
    holdingTime: String
    creationTime: String
    currentTime: String
    vehicleId: String
    stopId: String
    tripId: String
    routeId: String
    arrivalPredictionUsed: Boolean
    arrivalUsed: Boolean
    arrivalTime: String
    hasN1: Boolean
    hasN2: Boolean
    hasD1: Boolean
    numberPredictionsUsed: Int
}

enum BlockAssignmentMethod {
    # Block assignment came from AVL feed
    AVL_FEED_BLOCK_ASSIGNMENT

    # AVL feed provided a route assignment
    AVL_FEED_ROUTE_ASSIGNMENT

    # Separate block feed provided the assignment. Not currently implemented!
    BLOCK_FEED

    # The auto assignment feature provided the assignment.
    AUTO_ASSIGNER

    # Vehicle finished the assignment or was assigned to another block
    ASSIGNMENT_TERMINATED

    # For when another vehicle gets an exclusive assignment indicating that
    # the assignment needs to be removed from the old vehicle
    ASSIGNMENT_GRABBED,

    # Vehicle could not be matched to the assignment
    COULD_NOT_MATCH
}
type VehicleDetails {
    id: String
    loc: GpsLocation
    routeId: String
    routeShortName: String
    headsign: String
    vehicleType: String
    routeName: String
    vehicleName: String
    layoverDepTime: Float
    layoverDepTimeStr: String
    nextStopId: String
    nextStopName: String
    isScheduledService: Boolean
    freqStartTime: Float
    isAtStop: Boolean
    holdingTime: HoldingTime
    distanceAlongTrip: Float
    licensePlate: String
    fullness: String
    isCanceled: Boolean
    headway: Float
    expectedHeadway: Float
    headwayDeviation: Float
    headwayDeviationCategory: String
    canceled: Boolean
    direction: String
    scheduleBased: Boolean
    schAdh: Int
    schAdhStr: String
    block: String
    blockMethod: BlockAssignmentMethod
    trip: String
    tripPattern: String
    delayed: Boolean
    layover: Boolean
    driver: String
}

type Location {
    lat: Float
    lon: Float
}

type VehicleConfig {
    id: String
    type: Int
    description: String
    capacity: Int
    crushCapacity: Int
    nonPassengerVehicle: Boolean
    name: String
}

type AdherenceSummary {
    late: Int
    ontime: Int
    early: Int
    nodata: Int
    blocks: Int
}

type DateParam {
    date: String
}

type ArrivalDeparture {
    stopId: String
    vehicleId: String
    time: String
    scheduledTime: String
    isArrival: Boolean
    tripId: String
    routeId: String
    stopPathIndex: Int
    arrival: Boolean
}

type ScheduleArrDepTime {
    arrivalTime: String
    departureTime: String
    stopId: String
    stopName: String
}

type StopPath {
    configRev: Int
    stopPathId: String
    stopId: String
    stopName: String
    gtfsStopSeq: Int
    layoverStop: Boolean
    waitStop: Boolean
    scheduleAdherenceStop: Boolean
    breakTime: Int
    locations: [Location]
    pathLength: Float
}

type Trip {
    configRev: Int
    id: String
    shortName: String
    startTime: String
    endTime: String
    directionId: String
    routeId: String
    routeShortName: String
    tripPattern: TripPattern
    serviceId: String
    headsign: String
    blockId: String
    shapeId: String
    noSchedule: Boolean
    schedule: [ScheduleArrDepTime]
}

type TripPattern {
    configRev: Int
    id: String
    headsign: String
    directionId: String
    routeId: String
    routeShortName: String
    extent: Extent
    shapeId: String
    stopPaths: [StopPath]
}

type TravelTimeForSegment {
    segmentIndex: Int
    segmentTimeMsec: Int
    speedInMph: Float
    speedInKph: Float
    speedInMetersPerSec: Float
}

type TravelTimes {
    configRev: Int
    travelTimeRev: Int
    tripPatternId: String
    tripCreatedForId: String
    travelTimesForStopPaths: [TravelTimesForStopPath]
}

type TravelTimesForStopPath {
    stopPathIndex: Int
    stopPathId: String
    travelTimeSegmentLength: Float
    stopTimeMsec: Int
    totalTravelTimeMsec: Int
    howSet: String
    travelTimesForSegments: [TravelTimeForSegment]
}

type TripWithTravelTimes {
    configRev: Int
    id: String
    shortName: String
    startTime: String
    endTime: String
    directionId: String
    routeId: String
    routeShortName: String
    tripPattern: TripPattern
    serviceId: String
    headsign: String
    blockId: String
    shapeId: String
    noSchedule: Boolean
    travelTimes: TravelTimes
    schedule: [ScheduleArrDepTime]
}

type Direction {
    id: String
    title: String
    stop: [Stop]
}

type Stop {
    lat: Float
    lon: Float
    id: String
    name: String
    code: Int
    minor: Boolean
    pathLength: Float
}

type ServiceId {
    id: String
    blockIds: [String]
}

type HistoricalAverageCacheKey {
    tripId: String
    stopPathIndex: Int
}

type ScheduleTime {
    timeStr: String
    timeSecs: Int
}

type ScheduleTimesForStop {
    stopId: String
    stopName: String
    time: [ScheduleTime]
}

type ScheduleTrip {
    tripShortName: String
    tripId: String
    tripHeadsign: String
    blockId: String
}

type ScheduleVertStops {
    serviceId: String
    serviceName: String
    directionId: String
    routeId: String
    routeName: String
    timesForStop: [ScheduleTimesForStop]
    trip: [ScheduleTrip]
}

type SchedulesVertStopsResponse {
    routeId: String
    routeName: String
    schedule: [ScheduleVertStops]
}

type ScheduleHorizStops {
    serviceId: String
    serviceName: String
    directionId: String
    routeId: String
    routeName: String
    stops: [ScheduleStop]
    timesForTrip: [ScheduleTimesForTrip]
}

type ScheduleStop {
    stopId: String
    stopName: String
}

type ScheduleTimesForTrip {
    tripShortName: String
    tripId: String
    tripHeadsign: String
    blockId: String
    time: [ScheduleTime]
}

type SchedulesHorizStopsResponse {
    routeId: String
    routeName: String
    schedule: [ScheduleHorizStops]
}

type Route {
    id: String
    name: String
    shortName: String
    longName: String
    type: String
}

type RoutesResponse {
    agencyName: String
    routes: [Route]
}

type RouteDetails {
    id: String
    name: String
    shortName: String
    longName: String
    color: String
    textColor: String
    type: String
    extent: Extent
    locationOfNextPredictedVehicle: Location
    direction: [Direction]
    shape: [Shape]
}

type RoutesDetailsResponse {
    agency: String
    routes: [RouteDetails]
}

type Shape {
    headsign: String
    minor: Boolean
    length: Float
    directionId: String
    patternType: String
    tripPattern: String
    loc: [Location]
}

type KalmanErrorCacheKey {
    tripId: String
    stopPathIndex: Int
}

type HoldingTimeCacheKey {
    stopid: String
    vehicleId: String
    tripId: String
}

type HistoricalAverage {
    count: Int
    average: Float
}

type PredictionForStopPath {
    tripId: String
    stopPathIndex: Int
    creationTime: String
    predictionTime: Float
    algorithm: String
}

type ExportData {
    id: Float
    dataDate: Float
    exportDate: Float
    exportType: Int
    exportStatus: Int
    fileName: String
    file: String
}

type Calendar {
    serviceId: String
    monday: Boolean
    tuesday: Boolean
    wednesday: Boolean
    thursday: Boolean
    friday: Boolean
    saturday: Boolean
    sunday: Boolean
    startDate: String
    endDate: String
}

type CacheDetails {
    name: String
    size: Int
}

type Block {
    configRev: Int
    id: String
    serviceId: String
    startTime: String
    endTime: String
    trips: [Trip]
    routes: [Route]
}

type BlockTerse {
    configRev: Int
    id: String
    serviceId: String
    startTime: String
    endTime: String
    trips: [TripTerse]
    routes: [Route]
}

type TripTerse {
    id: String
    shortName: String
    startTime: String
    endTime: String
    directionId: String
    headsign: String
    routeId: String
    routeShortName: String
}

type ActiveBlock {
    id: String
    serviceId: String
    startTime: String
    endTime: String
    trip: TripTerse
    vehicle: [VehicleDetails]
}

type ActiveBlocksRoute {
    id: String
    shortName: String
    name: String
    block: [ActiveBlock]
}

input DateParamInput {
    date: String
}

type Query {
    "Gets predictions from server by location"
    getPredictions(lat: Float!, lon: Float!, maxDistance: Float, numPreds: Int): [PredictionsResponse]
    "Retrieves all tha agencies managed by the server."
    getAgencies: [Agency]
    "Returns data for all vehicles or for the vehicles specified via the query string."
    getVehicles(agency: String!, vehicles: [String], routes: [String], stop: String, numPreds: Int): [Vehicle]
    "Returns data for vehicles assignment for specific block id"
    getVehiclesToBlock(agency: String!, actual: Boolean, blockId: String): [VehicleToBlockConfig]
    "Returns detailed data for all vehicles or for the vehicles specified via the query string"
    getVehiclesDetails(agency: String!, v: [String], r: [String], s: String, numPreds: Int, onlyAssigned: Boolean): [VehicleDetails]
    "It gets the location for the specified vehicle."
    getVehicleLocation(agency: String!, v: String!): Location
    "Returns a list of vehicles with its configuration."
    getVehicleConfigs(agency: String!): [VehicleConfig]
    "Returns the counters  for the number of current vehicles running early, late or on time. "
    getVehicleAdherenceSummary(agency: String!, allowableEarlySec: Int, allowableLateSec: Int, t: Int): AdherenceSummary
    "Returns the arrivals and departures for a trip on a specific day and start time."
    getTripArrivalDepartureCacheData(agency: String!, tripId: String, date: DateParamInput, starttime: Int): [ArrivalDeparture]
    "Gets the configuration data of a trip."
    getTrip(agency: String!, tripId: String!): Trip
    "Gets the configuration data of a trip."
    getTripWithTravelTimes_1(agency: String!, tripId: String!): TripWithTravelTimes
    "Retrieves a list of all trip patters."
    getTripPatterns(agency: String!, r: String!): [TripPattern]
    "Retrieves a list of all tripIds"
    getTripIds(agency: String!): [String]
    "Retrieves bus stops from the server."
    getStops(agency: String!, r: String): [Direction]
    "Returns a list of current arrival or departure events for a specified stop that are in the cache."
    getStopArrivalDepartureCacheData(agency: String!, stopid: String!, date: String!): [ArrivalDeparture]
    "Retrieves all service id."
    getServiceIds(agency: String!): [String]
    "Retrieves all service id with block ids."
    getServiceIdsWithBlocks(agency: String!): [ServiceId]
    "Gets a list of the keys that have values in the historical average cache for schedules based services."
    getSchedulesBasedHistoricalAverageCacheKeys(agency: String!): [HistoricalAverageCacheKey]
    "Retrieves schedule for the specified route."
    getScheduleVertStops(agency: String!, r: String!): SchedulesVertStopsResponse
    "Retrieves schedule for the specified route."
    getScheduleHorizStops(agency: String!, r: String!): SchedulesHorizStopsResponse
    "Gets the list of routes."
    getRoutes(agency: String!, r: [String], keepDuplicates: Boolean): RoutesResponse
    "Provides detailed information for a route."
    getRouteDetails(agency: String!, r: [String], d: String, s: String, tripPattern: String): RoutesDetailsResponse
    "Provides detailed information for a route."
    getRouteDetailsByStopId(agency: String!, id: String!): RoutesDetailsResponse
    "Gets predictions from server"
    getPredictions_1(agency: String!, rs: [String]!, s: [String]!, numPreds: Int): PredictionsResponse
    "Gets predictions from server by location"
    getPredictions_2(agency: String!, lat: Float!, lon: Float!, maxDistance: Float, numPreds: Int): PredictionsResponse
    "Gets the list of Kalman Cache error."
    getKalmanErrorCacheKeys(agency: String!): [KalmanErrorCacheKey]
    "Gets a list of the keys for the holding times in the cache."
    getHoldingTimeCacheKeys(agency: String!): [HoldingTimeCacheKey]
    "Returns the historical cache value for an individual stop path index of a trip."
    getHistoricalAverageCacheData(agency: String!, tripId: String!, stopPathIndex: Int!): HistoricalAverage
    "Returns a list of predictions for a the stop path of a trip."
    getStopPathPredictions(agency: String!, algorithm: String, tripId: String!, stopPathIndex: Int!, date: DateParamInput!): [PredictionForStopPath]
    "Returns the IpcHoldingTime for a specific stop Id and vehicle Id."
    getHoldingTime(agency: String!, stopId: String!, vehicleId: String!): HoldingTime
    "Gets a list of the keys that have values in the historical average cache for frequency based services."
    getFrequencyBasedHistoricalAverageCacheKeys(agency: String!): [HistoricalAverageCacheKey]
    "Returns exports list"
    getExports(agency: String!, type: Int!): [ExportData]
    "Retrieves current service id."
    getCurrentServiceIds(agency: String!): [String]
    "Retrieves current calendar information."
    getCurrentCalendars(agency: String!): [Calendar]
    "Returns the number of entries in the cacheName cache."
    getCacheInfo(agency: String!, cacheName: String!): CacheDetails
    "Retrieves configuration data for the specified block ID"
    getBlocks(agency: String!, blockId: String!): [Block]
    "Retrieves configuration data for the specified block ID if set."
    getBlocksTerse(agency: String!, blockId: String): [BlockTerse]
    "Retrieves configuration data for the specified block ID and service ID"
    getBlock(agency: String!, blockId: String!, serviceId: String!): Block
    "Retrieves a list of all blockId for the specified service ID"
    getBlockIds(agency: String!, serviceId: String): [String]
    "Retrieves all calendar information."
    getAllCalendars(agency: String!): [Calendar]
    "Gets which blocks are active"
    getActiveBlocks(agency: String!, r: [String], t: Int): [ActiveBlock]
    "Gets which blocks are active by route"
    getActiveBlocksByRoute(agency: String!, r: [String], t: Int): [ActiveBlocksRoute]
    "Gets which blocks are active by route."
    getActiveBlocksByRouteWithoutVehicles(agency: String!, r: [String], t: Int): [ActiveBlocksRoute]
    "Gets which blocks are active by route."
    getActiveBlockByRouteWithVehicles(agency: String!, r: String, t: Int): [ActiveBlocksRoute]
    "Gets which blocks are active by routeName."
    getActiveBlockByRouteNameWithVehicles(agency: String!, r: String, t: Int): [ActiveBlocksRoute]
}

type Mutation {
    "Reads in a single AVL report specified by the query string parameters"
    pushAvlData(agency: String!, v: String!, t: Float!, lat: Float!, lon: Float!, s: Float, h: Float, assignmentId: String, assignmentType: String!): CommandAck
    "Cancel a trip in order to be shown in GTFS realtime."
    cancelTrip(agency: String!, tripId: String!): CommandAck
    "Reset a vehicle"
    resetVehicles(agency: String!, v: [String]!): CommandAck
    "Add vehicles to block"
    removeVehicleToBlock(agency: String!, id: Float!): CommandAck
    "Revert the canceled trip."
    reEnableTrip(agency: String!, tripId: String!): CommandAck
    "Reads in information from request and stores arrival information into db"
    pushAvlData_2(agency: String!, r: String!, rShortName: String!, s: String!, d: String!, headsign: String!): CommandAck
}