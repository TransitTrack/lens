scalar Long

extend type Query {
    drafts(feedCode: String): [Draft!]!
    draft(id: ID!): Draft
    draftEdits(id: ID!, limit: Int = 200): [DraftEdit!]!
    draftJob(jobId: ID!): DraftJob
    draftGrid(draftId: ID!, routeId: String!, directionId: Int, serviceId: String): DraftGrid!
}

type DraftGrid {
    stops: [DraftGridStop!]!
    trips: [DraftGridTrip!]!
}

type DraftGridStop {
    stopSequence: Int!
    stopId: String
    stopName: String
    timepoint: Int
}

type DraftGridTrip {
    tripId: String!
    firstDepartureSec: Int
    headsign: String
    blockId: String
    directionId: Int
    serviceId: String
    cells: [DraftGridCell!]!
}

type DraftGridCell {
    stopSequence: Int!
    arrivalSec: Int
    departureSec: Int
}

extend type Mutation {
    rebuildDraft(id: ID!): DraftJob!
    forkDraft(input: ForkDraftInput!): Draft!
    discardDraft(id: ID!, editor: String!): Boolean!
    revertDraftToFork(id: ID!, editor: String!): Draft!
    activateDraft(id: ID!, editor: String!, force: Boolean = false): Revision!

    claimDraftEditor(id: ID!, editor: String!, takeOver: Boolean = false): DraftLock!
    renewDraftEditor(id: ID!, editor: String!): DraftLock!
    releaseDraftEditor(id: ID!, editor: String!): Boolean!

    updateStopTime(input: UpdateStopTimeInput!): DraftEditResult!
    shiftTrip(input: ShiftTripInput!): DraftEditResult!
    setStopDwell(input: SetStopDwellInput!): DraftEditResult!
    addTrip(input: AddTripInput!): DraftEditResult!
    duplicateTrip(input: DuplicateTripInput!): DraftEditResult!
    deleteTrip(input: DeleteTripInput!): DraftEditResult!
    bulkShiftTrips(input: BulkShiftTripsInput!): DraftEditResult!
    insertTripStop(input: InsertTripStopInput!): DraftEditResult!
    removeTripStop(input: RemoveTripStopInput!): DraftEditResult!
    reorderTripStops(input: ReorderTripStopsInput!): DraftEditResult!
    undoDraftEdit(id: ID!, editor: String!, expectedVersion: Long!): DraftEditResult!
    redoDraftEdit(id: ID!, editor: String!, expectedVersion: Long!): DraftEditResult!
}

input UpdateStopTimeInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    stopSequence: Int!
    "null clears the value; omitting is the same as null"
    arrivalSec: Int
    "null clears the value; omitting is the same as null"
    departureSec: Int
}

input ShiftTripInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    deltaSec: Int!
}

input SetStopDwellInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    stopSequence: Int!
    dwellSec: Int!
}

input NewStopTimeInput {
    stopId: String!
    arrivalSec: Int!
    departureSec: Int!
}

input AddTripInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    routeId: String!
    serviceId: String!
    tripId: String
    headsign: String
    directionId: Int
    shapeId: String
    blockId: String
    stops: [NewStopTimeInput!]!
}

input DuplicateTripInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    sourceTripId: String!
    newTripId: String
    offsetSec: Int!
}

input DeleteTripInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
}

input BulkShiftTripsInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    routeId: String
    patternKey: String
    serviceId: String
    windowFromSec: Int
    windowToSec: Int
    deltaSec: Int!
}

input InsertTripStopInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    afterStopSequence: Int!
    stopId: String!
    arrivalSec: Int
    departureSec: Int
}

input RemoveTripStopInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    stopSequence: Int!
}

input ReorderTripStopsInput {
    draftId: ID!
    editor: String!
    expectedVersion: Long!
    tripId: String!
    stopIdOrder: [String!]!
}

type Draft {
    id: ID!
    feedCode: String!
    label: String
    baseRevisionId: ID
    status: String!
    kind: String!
    version: Long!
    derivationStale: Boolean!
    lastValidation: JSON
    lock: DraftLock
    createdBy: String
    createdAt: String!
    rowCounts: JSON
}

type DraftJob {
    id: ID!
    state: String!
    phase: String!
    error: String
}

type DraftLock {
    editor: String!
    expiresAt: String!
}

type DraftEdit {
    seq: Int!
    op: String!
    summary: String!
    appliedAt: String!
    undone: Boolean!
}

# Consumed by later plans (edit mutations, undo/redo). Declared now so the type is stable.
type DraftEditResult {
    draft: Draft!
    edit: DraftEdit
    canUndo: Boolean!
    canRedo: Boolean!
}

input ForkDraftInput {
    feedCode: String!
    baseRevisionId: ID
    label: String
    editor: String!
}
