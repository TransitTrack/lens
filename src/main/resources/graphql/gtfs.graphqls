scalar JSON

type Query {
    feeds: [Feed!]!
    feed(code: String!): Feed
    revisions(feedCode: String!, status: RevisionStatus): [Revision!]!
    revision(id: ID!): Revision
}

type Mutation {
    registerFeed(input: RegisterFeedInput!): Feed!
    updateFeed(code: String!, input: UpdateFeedInput!): Feed!
    deleteFeed(code: String!): Boolean!
    ingestFeed(feedCode: String!): Revision!
    activateRevision(revisionId: ID!): Revision!
    deleteRevision(revisionId: ID!): Boolean!
}

enum RevisionStatus {
    PENDING
    DOWNLOADING
    VALIDATING
    PARSING
    DERIVING
    READY
    ACTIVE
    SUPERSEDED
    FAILED
    UNCHANGED
    DRAFT
}

type Feed {
    code: String!
    name: String!
    description: String
    url: String!
    pollingCron: String
    enabled: Boolean!
    source: String!
    activeRevision: Revision
    revisions: [Revision!]!
}

type Revision {
    id: ID!
    feedCode: String!
    status: RevisionStatus!
    createdAt: String!
    activatedAt: String
    supersededAt: String
    contentSha256: String
    byteSize: Int
    filesPresent: [String!]!
    rowCounts: JSON
    feedStartDate: String
    feedEndDate: String
    validationSummary: ValidationSummary
    errorMessage: String
}

type ValidationSummary {
    errorCount: Int!
    warningCount: Int!
}

input RegisterFeedInput {
    code: String!
    name: String!
    description: String
    url: String!
    pollingCron: String
    enabled: Boolean
    autoActivate: Boolean
}

input UpdateFeedInput {
    name: String!
    description: String
    url: String!
    pollingCron: String
    enabled: Boolean
    autoActivate: Boolean
}

extend type Query {
    agencies(feedCode: String!, revisionId: ID): [Agency!]!
    routes(feedCode: String!, revisionId: ID): [Route!]!
    route(feedCode: String!, routeId: String!, revisionId: ID): Route
    stops(feedCode: String!, revisionId: ID): [Stop!]!
    stop(feedCode: String!, stopId: String!, revisionId: ID): Stop
    trips(feedCode: String!, routeId: String, serviceId: String, revisionId: ID): [Trip!]!
    trip(feedCode: String!, tripId: String!, revisionId: ID): Trip
    stopTimes(feedCode: String!, tripId: String!, revisionId: ID): [StopTime!]!
    calendars(feedCode: String!, revisionId: ID): [Calendar!]!
    calendarDates(feedCode: String!, serviceId: String, revisionId: ID): [CalendarDate!]!
    shape(feedCode: String!, shapeId: String!, revisionId: ID): Shape
    frequencies(feedCode: String!, tripId: String, revisionId: ID): [Frequency!]!
    transfers(feedCode: String!, revisionId: ID): [Transfer!]!
    feedInfo(feedCode: String!, revisionId: ID): FeedInfo
    pathways(feedCode: String!, revisionId: ID): [Pathway!]!
    levels(feedCode: String!, revisionId: ID): [Level!]!
}

type Extent { minLat: Float!, minLon: Float!, maxLat: Float!, maxLon: Float! }
type Agency { agencyId: String, agencyName: String, agencyUrl: String, agencyTimezone: String, agencyLang: String, agencyPhone: String, agencyFareUrl: String, agencyEmail: String, extent: Extent }
type Route { routeId: String!, agencyId: String, routeShortName: String, routeLongName: String, routeDesc: String, routeType: Int, routeUrl: String, routeColor: String, routeTextColor: String, routeSortOrder: Int, networkId: String, extent: Extent }
type Stop { stopId: String!, stopCode: String, stopName: String, stopDesc: String, stopLat: Float, stopLon: Float, zoneId: String, locationType: Int, parentStation: String, wheelchairBoarding: Int, levelId: String, platformCode: String }
type Trip { tripId: String!, routeId: String!, serviceId: String!, tripHeadsign: String, tripShortName: String, directionId: Int, blockId: String, shapeId: String, wheelchairAccessible: Int, bikesAllowed: Int, tripPatternId: ID }
type StopTime { tripId: String!, stopSequence: Int!, stopId: String, arrivalTime: String, arrivalTimeSeconds: Int, departureTime: String, departureTimeSeconds: Int, stopHeadsign: String, pickupType: Int, dropOffType: Int, shapeDistTraveled: Float, timepoint: Int }
type Calendar { serviceId: String!, monday: Boolean, tuesday: Boolean, wednesday: Boolean, thursday: Boolean, friday: Boolean, saturday: Boolean, sunday: Boolean, startDate: String, endDate: String }
type CalendarDate { serviceId: String!, date: String!, exceptionType: Int }
type ShapePoint { lat: Float, lon: Float, sequence: Int!, distTraveled: Float }
type Shape { shapeId: String!, pointCount: Int!, lengthM: Float, points: [ShapePoint!]! }
type Frequency { tripId: String!, startTime: String!, endTime: String, headwaySecs: Int, exactTimes: Int }
type Transfer { fromStopId: String, toStopId: String, fromRouteId: String, toRouteId: String, fromTripId: String, toTripId: String, transferType: Int, minTransferTime: Int }
type FeedInfo { feedPublisherName: String, feedPublisherUrl: String, feedLang: String, defaultLang: String, feedStartDate: String, feedEndDate: String, feedVersion: String, feedContactEmail: String, feedContactUrl: String }
type Pathway { pathwayId: String!, fromStopId: String, toStopId: String, pathwayMode: Int, isBidirectional: Int, length: Float, traversalTime: Int, stairCount: Int, maxSlope: Float, minWidth: Float, signpostedAs: String, reversedSignpostedAs: String }
type Level { levelId: String!, levelIndex: Float, levelName: String }

extend type Route { agency: Agency, trips: [Trip!]! }
extend type Trip { route: Route, stopTimes: [StopTime!]!, shape: Shape }
extend type StopTime { stop: Stop }
extend type Stop { childStops: [Stop!]!, level: Level }

extend type Query {
    records(feedCode: String!, table: Table!, revisionId: ID): [JSON!]!
}

enum Table {
    FARE_ATTRIBUTES FARE_RULES TIMEFRAMES RIDER_CATEGORIES FARE_MEDIA FARE_PRODUCTS
    FARE_LEG_RULES FARE_LEG_JOIN_RULES FARE_TRANSFER_RULES AREAS STOP_AREAS NETWORKS
    ROUTE_NETWORKS LOCATION_GROUPS LOCATION_GROUP_STOPS LOCATIONS BOOKING_RULES
    TRANSLATIONS ATTRIBUTIONS
}
