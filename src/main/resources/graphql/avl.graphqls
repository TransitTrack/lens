extend type Query {
    avlFeeds: [AvlFeed!]!
    vehicles(feedCode: String!, matchedOnly: Boolean = false): [Vehicle!]!
    vehicle(feedCode: String!, vehicleId: String!): Vehicle
    avlReports(feedCode: String!, vehicleId: String!, since: String, limit: Int = 200): [AvlReport!]!
    avlReportCatalog(feedCode: String!): AvlReportCatalog!
    avlReportPage(feedCode: String!, vehicleId: String!, date: String!, startTime: String!, endTime: String!, page: Int = 1, pageSize: Int = 100): AvlReportPage!
}

type AvlFeed {
    code: String!
    name: String!
    gtfsFeedCode: String!
    format: String!
    pollIntervalSec: Int!
    assignmentMode: String!
    predictionAlgorithms: [String!]!
    enabled: Boolean!
    lastPollAt: String
    lastPollStatus: String
    lastPollReportCount: Int
}

type LatLon { lat: Float!, lon: Float! }

type Vehicle {
    vehicleId: String!
    label: String
    reportTs: String!
    position: LatLon!
    snappedPosition: LatLon
    bearing: Float
    speedMps: Float
    occupancyStatus: String
    matched: Boolean!
    stale: Boolean!
    scheduleAdherenceSec: Int
    stopPathIndex: Int
    distanceAlongTripM: Float
    trip: Trip
    block: Block
    pattern: TripPattern
    currentStop: Stop
}

type AvlReport {
    vehicleId: String!
    ts: String!
    processedAt: String!
    source: String!
    position: LatLon!
    bearing: Float
    speedMps: Float
    currentStatus: String
    occupancyStatus: String
    descTripId: String
    matchStatus: String!
    match: AvlReportMatch
}

type AvlReportCatalog {
    timeZone: String!
    vehicleIds: [String!]!
}

type AvlReportPage {
    items: [AvlReport!]!
    totalCount: Int!
    page: Int!
    pageSize: Int!
}

type AvlReportMatch {
    stopPathIndex: Int!
    distanceAlongTripM: Float!
    deviationM: Float!
    scheduleAdherenceSec: Int
    heading: Float
    score: Float
    snappedPosition: LatLon!
    trip: Trip
    block: Block
}
