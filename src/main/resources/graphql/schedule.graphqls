extend type Query {
    tripPatterns(feedCode: String!, routeId: String, revisionId: ID): [TripPattern!]!
    tripPattern(feedCode: String!, patternKey: String!, revisionId: ID): TripPattern
    schedTrip(feedCode: String!, tripId: String!, revisionId: ID): SchedTrip
    blocks(feedCode: String!, revisionId: ID): [Block!]!
    block(feedCode: String!, blockId: String!, serviceId: String!, revisionId: ID): Block
    blocksOnDate(feedCode: String!, date: String!, revisionId: ID): [Block!]!
    tripsOnDate(feedCode: String!, date: String!, routeId: String, revisionId: ID): [SchedTrip!]!
}

type TripPattern {
    patternKey: String!
    routeId: String!
    directionId: Int
    headsign: String
    shapeId: String
    stopCount: Int!
    lengthM: Float
    tripCount: Int!
    extent: Extent
    route: Route
    stopPaths: [StopPath!]!
    trips: [SchedTrip!]!
}

type StopPath {
    stopPathIndex: Int!
    stopId: String!
    stopSeq: Int!
    lengthM: Float!
    pathGeometry: JSON
    pickupType: Int
    dropOffType: Int
    waitStop: Boolean!
    scheduleAdherenceStop: Boolean!
    layoverStop: Boolean!
    breakTimeSec: Int
    typicalTravelTimeSec: Int
    typicalDwellTimeSec: Int
    stop: Stop
}

type SchedTrip {
    tripId: String!
    routeId: String!
    serviceId: String!
    directionId: Int
    headsign: String
    tripShortName: String
    startTimeSec: Int!
    endTimeSec: Int!
    frequencyBased: Boolean!
    exactTimes: Int
    pattern: TripPattern
    route: Route
    block: Block
    scheduleTimes: [ScheduleTime!]!
}

type ScheduleTime {
    stopPathIndex: Int!
    arrivalSec: Int
    departureSec: Int
    interpolated: Boolean!
    schedTravelTimeSec: Int
    schedDwellTimeSec: Int
}

type Block {
    id: ID!
    blockId: String!
    serviceId: String!
    startTimeSec: Int!
    endTimeSec: Int!
    tripCount: Int!
    routeIds: [String!]!
    trips: [SchedTrip!]!
    blockTrips: [BlockTrip!]!
}

type BlockTrip {
    listIndex: Int!
    layoverAfterSec: Int
    deadheadAfter: Boolean
    trip: SchedTrip!
}

extend type Route { tripPatterns: [TripPattern!]! }
extend type Trip { schedTrip: SchedTrip, tripPattern: TripPattern }
