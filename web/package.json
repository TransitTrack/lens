{
  "name": "web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "graphql-codegen --config graphql-codegen.ts && node scripts/dedupe-codegen-types.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@nuxt/ui": "^4.12.0",
    "tailwindcss": "^4.3.3",
    "@vue/apollo-composable": "^4.2.2",
    "graphql": "^16.14.2",
    "@indoorequal/vue-maplibre-gl": "^9.0.1",
    "maplibre-gl": "^6.14.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.1",
    "nuxt-maplibre": "^1.2.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-vue-apollo": "^5.0.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/geojson": "^7946.0.16",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.6",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
