server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # nginx's bundled mime.types has no entry for .mjs, so it falls back to
    # application/octet-stream — module workers (e.g. maplibre-gl's) are
    # fetched with strict MIME-type enforcement and the browser rejects that.
    # A location-scoped default_type (rather than a bare `types {}` block,
    # which replaces the whole inherited MIME map for every other asset)
    # covers just this extension.
    location ~* \.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
    }

    location /graphql {
        proxy_pass ${BACKEND_URL}/graphql;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    location /graphiql {
        proxy_pass ${BACKEND_URL}/graphiql;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    # Docs → Live configuration reads the backend's resolved `transittrack.*`
    # properties. Only this one read-only Actuator endpoint is proxied.
    location = /actuator/configprops {
        proxy_pass ${BACKEND_URL}/actuator/configprops;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
