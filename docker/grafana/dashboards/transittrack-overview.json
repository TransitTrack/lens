{
  "uid": "transittrack-overview",
  "title": "TransitTrack Overview",
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "feed",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(transittrack_avl_feed_age, feed)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Application scrape health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"transittrack\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "AVL feed age",
      "description": "Investigate provider availability when this rises above the feed polling cadence.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "transittrack_avl_feed_age{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Oldest pending AVL report",
      "description": "A growing age indicates matching cannot keep up.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "transittrack_avl_oldest_pending_report_age{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Match success ratio (5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum by (feed) (rate(transittrack_avl_reports_matched_total{outcome=\"matched\",feed=~\"$feed\"}[5m])) / sum by (feed) (rate(transittrack_avl_reports_matched_total{feed=~\"$feed\"}[5m]))",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Prediction MAE (30m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "sum by (feed, algorithm) (rate(transittrack_prediction_absolute_error_seconds_sum{feed=~\"$feed\"}[30m])) / sum by (feed, algorithm) (rate(transittrack_prediction_absolute_error_seconds_count{feed=~\"$feed\"}[30m]))",
          "legendFormat": "{{feed}} / {{algorithm}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Database pool utilization",
      "description": "Sustained saturation means imports or matching are waiting for database connections.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active / hikaricp_connections_max",
          "legendFormat": "active / max",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Outbound HTTP latency p95",
      "description": "Compare GTFS download and AVL poll provider latency without exposing full URLs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, purpose, host) (rate(transittrack_http_client_duration_seconds_bucket[10m])))",
          "legendFormat": "{{purpose}} / {{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cache hit ratio",
      "description": "Low hit rate can explain slow matching reads; use cache name to locate the affected lookup.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum by (cache) (rate(cache_gets_total{result=\"hit\"}[10m])) / sum by (cache) (rate(cache_gets_total[10m]))",
          "legendFormat": "{{cache}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "JVM heap and resident memory",
      "description": "Heap pressure or rising RSS can indicate a cache, import, or allocation problem.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "process RSS",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "CPU utilization",
      "description": "Sustained process or host CPU pressure can delay polling, matching, and prediction generation.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "TransitTrack process",
          "refId": "A"
        },
        {
          "expr": "system_cpu_usage",
          "legendFormat": "JVM host",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "JVM threads and GC pause",
      "description": "Thread growth or long garbage-collection pauses can explain delayed pipeline work.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live threads",
          "refId": "A"
        },
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "legendFormat": "GC pause seconds / second",
          "refId": "B"
        }
      ]
    }
  ]
}
