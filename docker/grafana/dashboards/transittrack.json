{
  "title": "TransitTrack",
  "uid": "transittrack",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "AVL Feed Age",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "transitclock_avl_feed_age_seconds", "legendFormat": "age", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "Active vs Total Blocks",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {"expr": "transitclock_blocks_active", "legendFormat": "active", "refId": "A"},
        {"expr": "transitclock_blocks_total", "legendFormat": "total", "refId": "B"}
      ]
    },
    {
      "id": 3,
      "title": "Predictability Fraction",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}, "overrides": []},
      "targets": [
        {"expr": "transitclock_predictability_fraction", "legendFormat": "predictable", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "title": "Database Write Queue",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {"expr": "transitclock_db_queue_level", "legendFormat": "level (0-1)", "refId": "A"},
        {"expr": "transitclock_db_queue_size", "legendFormat": "size", "refId": "B"}
      ]
    },
    {
      "id": 5,
      "title": "AVL Report Processing Time (avg)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "rate(transitclock_avl_report_process_time_seconds_sum[5m]) / rate(transitclock_avl_report_process_time_seconds_count[5m])",
          "legendFormat": "avg processing time",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "GTFS Reload Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "transitclock_gtfs_reload_time_seconds_max",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "targets": [
        {"expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "{{id}}", "refId": "A"}
      ]
    },
    {
      "id": 8,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "JVM Threads",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {"expr": "jvm_threads_live_threads", "legendFormat": "live", "refId": "A"},
        {"expr": "jvm_threads_daemon_threads", "legendFormat": "daemon", "refId": "B"},
        {"expr": "jvm_threads_peak_threads", "legendFormat": "peak", "refId": "C"},
        {"expr": "jvm_threads_states_threads", "legendFormat": "{{state}}", "refId": "D"}
      ]
    },
    {
      "id": 10,
      "title": "Task Executor Threads",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"expr": "executor_active_threads", "legendFormat": "{{name}} active", "refId": "A"},
        {"expr": "executor_pool_size_threads", "legendFormat": "{{name}} pool size", "refId": "B"}
      ]
    },
    {
      "id": 11,
      "title": "Task Queue Length",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {"expr": "executor_queued_tasks", "legendFormat": "{{name}} queued", "refId": "A"}
      ]
    },
    {
      "id": 12,
      "title": "Task Completion Rate",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {
          "expr": "rate(executor_completed_tasks_total[5m])",
          "legendFormat": "{{name}} completed/s",
          "refId": "A"
        }
      ]
    }
  ]
}
